<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_screen"
        android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/card_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="36dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/accent_purple"
                    android:layout_marginBottom="28dp" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN-код (4 цифри) :"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="10dp" />

            <EditText
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_pill"
                    android:hint="• • • •"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:letterSpacing="0.3"
                    android:paddingHorizontal="20dp" />

            <TextView
                    android:id="@+id/tvForgotPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/forgot_pin"
                    android:textColor="#2563EB"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginBottom="14dp" />

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_gradient_pill"
                    android:text="Увійти / Login"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:elevation="4dp"
                    android:layout_marginBottom="14dp" />

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBiometric"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_pill_outline"
                    android:text="🔒 Біометрія / Biometrics"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_purple"
                    android:textSize="15sp"
                    android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>